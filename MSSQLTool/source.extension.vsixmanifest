<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
    <Metadata>
        <Identity Id="MSSQLTool" Version="5.26" Language="zh-CN" Publisher="PuLuShen" />
        <DisplayName>MSSQL Tool</DisplayName>
        <Description xml:space="preserve">MSSQL Tool is a free, open-source SSMS (SQL Server Management Studio) extension for SSMS 22: context-aware SQL completion, T-SQL formatting, query history and result export. A free alternative to SQL Prompt for SQL Server developers and DBAs.</Description>
        <MoreInfo>https://github.com/PuLuShen/MSSQLTOOL</MoreInfo>
        <License>LICENSE</License>
        <GettingStartedGuide>https://github.com/PuLuShen/MSSQLTOOL/wiki</GettingStartedGuide>
        <Icon>Resources\vsix-logo.png</Icon>
        <PreviewImage>Resources\vsix-logo.png</PreviewImage>
    </Metadata>
    <Installation>
        <InstallationTarget Id="Microsoft.VisualStudio.Ssms" Version="[22.0,23.0)">
            <ProductArchitecture>amd64</ProductArchitecture>
        </InstallationTarget>
    </Installation>
    <Dependencies>
        <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.5,)" />
    </Dependencies>
    <Prerequisites>
        <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[18.0, )" DisplayName="Visual Studio core editor" />
    </Prerequisites>
    <Assets>
        <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
    </Assets>
</PackageManifest>
