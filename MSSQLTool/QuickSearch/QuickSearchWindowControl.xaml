<UserControl x:Class="MSSQLTool.QuickSearchWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             mc:Ignorable="d"
             Name="QuickSearchControl"
             Background="{DynamicResource ToolThemeBackgroundBrush}"
             Foreground="{DynamicResource ToolThemeForegroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MSSQLTool;component/Themes/SharedToolWindowTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ToolThemeBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="{DynamicResource ToolThemeHeaderBackgroundBrush}">
            <TextBlock Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" 
                       FontSize="18">Search for Object Definitions Across Multiple Databases</TextBlock>
            <TextBlock Margin="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Run Text="Feature description in"/>
                <Run Text=" "/>
                <Hyperlink NavigateUri="https://github.com/PuLuShen/MSSQLTOOL/wiki/Quick-Search"
                           RequestNavigate="WikiLink_RequestNavigate">
                    <Run Text="Wiki"/>
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <Grid Grid.Row="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="70"/>
                <RowDefinition Height="*" MinHeight="70"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>       
        
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,4,0,8">
            
                <Button Height="30"
                        Width="220"
                        Content="Select Target from Object Explorer"
                        FontWeight="Bold"
                        Click="Button_SelectConnection_Click" />
                <Label Content="Server:" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <ComboBox x:Name="ComboBox_Server"
                          Width="240"
                          Height="24"
                          Margin="4,0,0,0"
                          VerticalContentAlignment="Center"
                          SelectionChanged="ComboBox_Server_SelectionChanged"
                          ToolTip="Every server currently connected in Object Explorer. Pick one to search it, or select a node in Object Explorer first."/>
                <Label x:Name="Label_ConnectionDescription" Margin="8,0,0,0" VerticalAlignment="Center" Content="No connection selected"/>
            </StackPanel>

            <Grid Grid.Row="1" x:Name="SearchInputsGrid" Margin="0,0,0,8" IsEnabled="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Search for:" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1"
                          x:Name="ComboBox_SearchText"
                          Margin="6,0,12,0"
                          Height="24"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          VerticalContentAlignment="Center"
                          ToolTip="Up/Down recall recent searches. Enter searches, Ctrl+Enter searches every database, Esc clears."
                          KeyDown="ComboBox_SearchText_KeyDown"
                          GotKeyboardFocus="ComboBox_SearchText_GotKeyboardFocus"
                          PreviewTextInput="ComboBox_SearchText_PreviewTextInput"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <CheckBox x:Name="CheckBox_WholeWord" Content="Match whole words only" Margin="0,0,12,0"
                              Checked="CheckBox_WholeWord_Checked"
                              ToolTip="The term must match a whole identifier word. Combined with fuzzy matching, every word of the term must match a distinct word of the identifier."/>
                    <CheckBox x:Name="CheckBox_UseWildcards" Content="Use wildcards" Margin="0,0,12,0"
                              Checked="CheckBox_UseWildcards_Checked"
                              ToolTip="SQL LIKE wildcards: % for any text, _ for a single character. Cannot be combined with fuzzy matching."/>
                    <CheckBox x:Name="CheckBox_Fuzzy" Content="Fuzzy match" IsChecked="True"
                              Checked="CheckBox_Fuzzy_Checked"
                              ToolTip="Tolerates typos and separator differences, so uspGetOrd also finds usp_GetOrder. Cannot be combined with wildcards."/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="Button_Search" Content="Search" Width="90" Height="28" Click="Button_Search_Click" Style="{DynamicResource PrimaryButtonStyle}"/>
                    <Button x:Name="Button_CopyResults" Content="Copy results" Width="110" Height="28" Margin="6,0,0,0" Click="Button_CopyResults_Click"
                            ToolTip="Copy every result row as text (database, type, schema, object, location, match preview)."/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" x:Name="SearchScopeGrid" Margin="0,0,0,8" IsEnabled="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Object types:" VerticalAlignment="Center"/>
                        <CheckBox x:Name="CheckBox_StoredProcedures" Content="Stored Procedures" IsChecked="True" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="CheckBox_Views" Content="Views" IsChecked="True" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="CheckBox_Functions" Content="Functions" IsChecked="True" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="CheckBox_Tables" Content="Tables" IsChecked="True" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="CheckBox_AgentJobSteps" Content="SQL Agent Jobs" IsChecked="True" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TextBlock_KeyboardHint"
                               Margin="0,6,0,0"
                               FontSize="11"
                               Opacity="0.75"
                               TextWrapping="Wrap"
                               Text="Enter: search | Ctrl+Enter: search all databases | Esc: clear | Ctrl+Down: jump to results"/>
                </StackPanel>

                <GroupBox Grid.Column="1" Header="Databases" Width="320" Padding="6,2,6,6">
                    <Grid x:Name="DatabaseScopePanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      x:Name="ComboBox_DatabaseMode"
                                      Height="24"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="ComboBox_DatabaseMode_SelectionChanged"/>
                            <Button Grid.Column="1"
                                    x:Name="Button_RefreshDatabases"
                                    Content="Refresh"
                                    Margin="6,0,0,0"
                                    Padding="8,2"
                                    Click="Button_RefreshDatabases_Click"
                                    ToolTip="Reload the database list and states from the server."/>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,4">
                            <Button x:Name="Button_CheckAllDatabases" Content="Check all" Padding="8,2" Click="Button_CheckAllDatabases_Click"/>
                            <Button x:Name="Button_UncheckAllDatabases" Content="Uncheck all" Margin="6,0,0,0" Padding="8,2" Click="Button_UncheckAllDatabases_Click"/>
                            <TextBlock x:Name="TextBlock_DatabaseSummary" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" Opacity="0.75"/>
                        </StackPanel>

                        <ListBox Grid.Row="2"
                                 x:Name="ListBox_Databases"
                                 MinHeight="70"
                                 MaxHeight="130"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- Click (not Checked) so only real user interaction switches the
                                         scope to "specific databases"; container generation and the
                                         check all / uncheck all buttons must not trigger it. -->
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding CanBeSearched}"
                                              Content="{Binding DisplayName}"
                                              Click="DatabaseCheckBox_Click"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </GroupBox>
            </Grid>

            <DataGrid Grid.Row="3"
                      x:Name="DataGrid_SearchResults"
                      Style="{DynamicResource ToolThemedDataGridStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="DataGrid_SearchResults_SelectionChanged">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy selected result" Click="MenuItem_CopySelectedResult_Click"/>
                        <MenuItem Header="Copy all results" Click="MenuItem_CopyAllResults_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="130"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding ObjectType}" Width="140"/>
                    <DataGridTextColumn Header="Schema" Binding="{Binding SchemaName}" Width="120"/>
                    <DataGridTextColumn Header="Object" Binding="{Binding ObjectName}" Width="200"/>
                    <DataGridTextColumn Header="Location" Binding="{Binding MatchLocation}" Width="120"/>
                    <DataGridTextColumn Header="Match Preview" Binding="{Binding MatchPreview}" Width="*" FontFamily="Cascadia Mono"/>
                    <DataGridTemplateColumn Header="Script" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Script" Click="Button_ScriptResult_Click" Padding="8,2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <avalonedit:TextEditor  Grid.Row="4"
                x:Name="SqlEditor"
                ShowLineNumbers="True"
                FontFamily= "Consolas"
                FontSize="13"
                Background="{DynamicResource ToolThemeBackgroundBrush}"
                Foreground="{DynamicResource ToolThemeForegroundBrush}"
                IsReadOnly="True" />

            <StatusBar Grid.Row="5"
                       Background="{DynamicResource ToolThemeBackgroundBrush}"
                       Foreground="{DynamicResource ToolThemeForegroundBrush}">
                <StatusBar.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </StatusBar.ItemsPanel>
                <StatusBarItem Grid.Column="0">
                    <TextBlock x:Name="TextBlock_ResultCount" FontWeight="Bold"/>
                </StatusBarItem>
                <StatusBarItem Grid.Column="1">
                    <TextBlock x:Name="TextBlock_ObjectTypeCounts" Margin="12,0,0,0"/>
                </StatusBarItem>
                <StatusBarItem Grid.Column="2">
                    <TextBlock x:Name="TextBlock_Elapsed"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</UserControl>
