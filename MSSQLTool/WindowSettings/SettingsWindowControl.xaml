<UserControl x:Class="MSSQLTool.SettingsWindowControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	mc:Ignorable="d"
    Name="MyToolWindow"
    Background="{DynamicResource ToolThemeBackgroundBrush}"
    Foreground="{DynamicResource ToolThemeForegroundBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MSSQLTool;component/Themes/SharedToolWindowTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Geometry x:Key="SaveIconGeometry">M1,1 L11,1 L13,3 L13,13 L1,13 Z M3,2 L3,5 L9,5 L9,2 Z M4,8 L10,8 L10,12 L4,12 Z</Geometry>

            <Style x:Key="SaveIconPathStyle" TargetType="Path">
                <Setter Property="Fill" Value="{DynamicResource ToolThemeAccentBrush}" />
                <Setter Property="Stretch" Value="Fill" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style x:Key="SettingsGridViewHeaderStyle" TargetType="GridViewColumnHeader">
                <Setter Property="Background" Value="{DynamicResource ToolThemeGridHeaderBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ToolThemeForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ToolThemeBorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewColumnHeader">
                            <Border x:Name="HeaderBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource ToolThemeButtonHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource ToolThemeGridSelectionBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingsListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource ToolThemeForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ToolThemeBorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <GridViewRowPresenter Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                      Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                      Content="{TemplateBinding Content}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ToolThemeButtonHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ToolThemeGridSelectionBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource ToolThemeForegroundBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <DockPanel Background="{DynamicResource ToolThemeBackgroundBrush}">
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource ToolThemeHeaderBackgroundBrush}"
                Padding="12" BorderBrush="{DynamicResource ToolThemeBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="MSSQL Tool - Settings"
                           FontWeight="Bold"
                           FontSize="20"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="SettingsSearchBox" Width="180" VerticalContentAlignment="Center"
                             Padding="4,2" ToolTip="Filter settings pages by name"
                             TextChanged="SettingsSearchBox_TextChanged"/>
                    <Button x:Name="Button_RestoreDefaults" Content="Restore defaults" Width="120"
                            Height="24" Margin="8,0,0,0" Click="Button_RestoreDefaults_Click"
                            ToolTip="Reset the settings on the current page to their default values"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="SettingsTabs"
                    Margin="5"
                    Background="{DynamicResource ToolThemeBackgroundBrush}"
                    BorderBrush="{DynamicResource ToolThemeBorderBrush}"
					BorderThickness="1">

            <TabItem Header="Language">
                <StackPanel Margin="16" MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Text="Interface language:" Margin="0,0,0,8" />
                    <ComboBox x:Name="UiLanguageSelector" Width="220" HorizontalAlignment="Left" SelectedValuePath="Tag">
                        <ComboBoxItem Content="Simplified Chinese" Tag="zh-CN" />
                        <ComboBoxItem Content="English" Tag="en-US" />
                    </ComboBox>
                    <Button Content="Apply" Width="90" HorizontalAlignment="Left" Margin="0,12,0,0"
                            Click="Button_ApplyLanguage_Click" />
                    <TextBlock Text="The language setting applies immediately to MSSQL Tool windows. Toolbar command labels use the package default language."
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Storage">
                <StackPanel Margin="16" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="Data and configuration folder" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,12"
                               Text="MSSQL Tool keeps its settings, query history, completion ranking, GitHub sync profiles, snippets, query templates and log files in one folder. Point that folder at another drive, a synced folder or a portable device to keep the data outside your Windows profile. The pointer itself stays in the registry, and every setting is mirrored there, so the default location keeps working if the folder is unavailable. A query template folder you picked yourself is left where it is."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Data folder:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="DataFolderPath" IsReadOnly="True" Margin="0,0,8,0"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="2" Content="Browse..." Width="90" Click="Button_BrowseDataFolder_Click"/>
                        <Button Grid.Column="3" Content="Open folder" Width="100" Margin="8,0,0,0"
                                Click="Button_OpenDataFolder_Click"/>
                        <Button Grid.Column="4" Content="Restore default" Width="120" Margin="8,0,0,0"
                                Click="Button_ResetDataFolder_Click"/>
                    </Grid>

                    <CheckBox x:Name="DataFolderMoveExisting" Margin="0,12,0,0" IsChecked="True"
                              Content="Copy existing data to the new folder"/>

                    <TextBlock x:Name="DataFolderStatus" TextWrapping="Wrap" Margin="0,12,0,0" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DataFolderStorage" TextWrapping="Wrap" Opacity="0.8" Margin="0,6,0,0"/>

                    <TextBlock Text="Locations in use" FontWeight="SemiBold" Margin="0,18,0,6"/>
                    <TextBox x:Name="DataFolderLocations" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Height="150"/>

                    <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,10,0,0"
                               Text="Changes apply immediately: the completion ranking, query history, snippets, query templates and settings move to the new folder at once. The log file follows after the next SSMS start."/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Keyboard shortcuts">
                <StackPanel Margin="16" MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock Text="Script Object Definition" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Open definition script:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="ScriptObjectShortcut" Margin="0,0,8,0"
                                 VerticalContentAlignment="Center" ToolTip="Examples: F12, Ctrl+F12, Ctrl+Shift+O, or None"/>
                        <Button Grid.Column="2" Content="Apply" Width="90" Click="Button_ApplyScriptObjectShortcut_Click"
                                Style="{DynamicResource PrimaryButtonStyle}"/>
                    </Grid>
                    <TextBlock Text="Select an object name in the SQL editor, then use this shortcut to open its definition script. Enter None to remove the shortcut."
                               TextWrapping="Wrap" Opacity="0.8" Margin="0,10,0,0"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="SQL Completion">
                <StackPanel Margin="16" MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock Text="Smart SQL completion" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox x:Name="UseSqlCompletion" Content="Enable smart SQL completion" Margin="0,4"/>
                    <StackPanel IsEnabled="{Binding IsChecked, ElementName=UseSqlCompletion}">
                        <CheckBox x:Name="AutomaticSqlCompletion"
                                  Content="Show completion automatically while typing" Margin="0,4"/>
                        <CheckBox x:Name="CompletionTrustServerCertificate"
                                  Content="Trust the SQL Server certificate for completion metadata" Margin="0,4"
                                  ToolTip="Applies only to the background connection used to load completion metadata."/>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <CheckBox x:Name="CompletionSquareBrackets" Content="Insert square brackets"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <CheckBox x:Name="CompletionAutoRefreshMetadata" Content="Refresh metadata after schema changes"/>
                            <CheckBox x:Name="CompletionShowObjectDetails" Content="Show object details" Margin="18,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <CheckBox x:Name="CompletionColumnPicker" Content="Enable categorized column picker"/>
                            <CheckBox x:Name="CompletionAutoAliases" Content="Add table aliases automatically" Margin="18,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Alias prefixes to ignore (comma separated):" Margin="0,6,0,2"/>
                        <TextBox x:Name="CompletionAliasPrefixes"/>
                        <TextBlock Text="Custom aliases (Object=alias; ...):" Margin="0,6,0,2"/>
                        <TextBox x:Name="CompletionCustomAliases"/>
                        <TextBlock Text="JOIN rules (Source.Column=Target.Column; ...):" Margin="0,6,0,2"/>
                        <TextBox x:Name="CompletionJoinRules"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Popup delay (ms):" VerticalAlignment="Center"/>
                            <TextBox x:Name="CompletionDelay" Width="60" Margin="8,0,0,0"/>
                            <TextBlock Text="Maximum matches:" VerticalAlignment="Center" Margin="18,0,0,0"/>
                            <TextBox x:Name="CompletionMaximumItems" Width="60" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Button Content="Clear and refresh completion cache"
                                Click="Button_RefreshCompletionMetadata_Click" Margin="0,8,0,0"
                                Width="220" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="CompletionMetadataStatus" TextWrapping="Wrap" Opacity="0.8" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Button Content="Save" Click="Button_SaveSqlCompletion_Click"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Width="90" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                    <TextBlock Text="The setting applies immediately. Ctrl+Space can still open completion when automatic popup is disabled."
                               TextWrapping="Wrap" Opacity="0.8" Margin="0,10,0,0"/>
                </StackPanel>
            </TabItem>





            <TabItem Header="Code Format">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="5" HorizontalAlignment="Left">
                        <Run Text="Feature description in"/>
                        <Hyperlink
                            NavigateUri="https://github.com/PuLuShen/MSSQLTOOL/wiki/TSQL-Code-Formatting-with-Microsoft-ScriptDOM-library"
                            RequestNavigate="buttonWikiPage_Click">
                            <Run Text="Wiki"/>
                        </Hyperlink>
                    </TextBlock>

                    <StackPanel Grid.Row="1" Margin="5" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Preset:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="FormatPresetSelector" Width="160" Margin="8,0,0,0"
                                      SelectionChanged="FormatPresetSelector_SelectionChanged">
                                <ComboBoxItem Content="Standard" Tag="Standard"/>
                                <ComboBoxItem Content="Compact" Tag="Compact"/>
                                <ComboBoxItem Content="Readable" Tag="Readable"/>
                                <ComboBoxItem Content="Team standard" Tag="Team"/>
                                <ComboBoxItem Content="Custom" Tag="Custom"/>
                            </ComboBox>
                            <TextBlock Text="Indent size:" VerticalAlignment="Center" Margin="18,0,0,0"/>
                            <ComboBox x:Name="FormatIndentSizeSelector" Width="60" Margin="8,0,0,0"
                                      SelectionChanged="FormatSetting_Changed">
                                <ComboBoxItem Content="2" Tag="2"/>
                                <ComboBoxItem Content="4" Tag="4"/>
                                <ComboBoxItem Content="8" Tag="8"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Text="Keyword casing:" Margin="0,10,0,2"/>
                        <ComboBox x:Name="FormatKeywordCasingSelector" Width="180" HorizontalAlignment="Left"
                                  SelectionChanged="FormatSetting_Changed">
                            <ComboBoxItem Content="Uppercase" Tag="Uppercase"/>
                            <ComboBoxItem Content="Lowercase" Tag="Lowercase"/>
                            <ComboBoxItem Content="PascalCase" Tag="PascalCase"/>
                        </ComboBox>

                        <TextBlock Text="Built-in function casing:" Margin="0,10,0,2"/>
                        <ComboBox x:Name="FormatFunctionCasingSelector" Width="180" HorizontalAlignment="Left"
                                  SelectionChanged="FormatSetting_Changed">
                            <ComboBoxItem Content="Keep as written" Tag="Preserve"/>
                            <ComboBoxItem Content="Uppercase" Tag="Uppercase"/>
                            <ComboBoxItem Content="Lowercase" Tag="Lowercase"/>
                        </ComboBox>

                        <TextBlock Text="Data type casing:" Margin="0,10,0,2"/>
                        <ComboBox x:Name="FormatDataTypeCasingSelector" Width="180" HorizontalAlignment="Left"
                                  SelectionChanged="FormatSetting_Changed">
                            <ComboBoxItem Content="Keep as written" Tag="Preserve"/>
                            <ComboBoxItem Content="Uppercase" Tag="Uppercase"/>
                            <ComboBoxItem Content="Lowercase" Tag="Lowercase"/>
                        </ComboBox>

                        <TextBlock Text="Identifier casing:" Margin="0,10,0,2"/>
                        <ComboBox x:Name="FormatIdentifierCasingSelector" Width="180" HorizontalAlignment="Left"
                                  SelectionChanged="FormatSetting_Changed">
                            <ComboBoxItem Content="Keep as written" Tag="Preserve"/>
                            <ComboBoxItem Content="Uppercase" Tag="Uppercase"/>
                            <ComboBoxItem Content="Lowercase" Tag="Lowercase"/>
                        </ComboBox>

                        <UniformGrid Columns="3" Margin="0,12,0,0" HorizontalAlignment="Left">
                            <CheckBox x:Name="FormatAlignClauseBodies" Margin="5" Content="Align clause bodies"
                                      Checked="formatSetting_Checked" Unchecked="formatSetting_Unchecked"/>
                            <CheckBox x:Name="FormatIncludeSemicolons" Margin="5" Content="Add semicolons"
                                      Checked="formatSetting_Checked" Unchecked="formatSetting_Unchecked"/>
                            <CheckBox x:Name="FormatKeepShortQuerySingleLine" Margin="5" Content="Keep short queries on one line"
                                      Checked="formatSetting_Checked" Unchecked="formatSetting_Unchecked"/>
                            <CheckBox x:Name="FormatStackSelectColumns" Margin="5" Content="One select column per line"
                                      Checked="formatSetting_Checked" Unchecked="formatSetting_Unchecked"/>
                            <CheckBox x:Name="FormatNewLineBeforeJoin" Margin="5" Content="New line before JOIN"
                                      Checked="formatSetting_Checked" Unchecked="formatSetting_Unchecked"/>
                            <CheckBox x:Name="FormatNewLinePerCondition" Margin="5" Content="One AND/OR condition per line"
                                      Checked="formatSetting_Checked" Unchecked="formatSetting_Unchecked"/>
                            <CheckBox x:Name="FormatIndentSubquery" Margin="5" Content="Indent subqueries"
                                      Checked="formatSetting_Checked" Unchecked="formatSetting_Unchecked"/>
                            <CheckBox x:Name="FormatIndentCase" Margin="5" Content="Indent CASE bodies"
                                      Checked="formatSetting_Checked" Unchecked="formatSetting_Unchecked"/>
                            <CheckBox x:Name="FormatStatementPerLine" Margin="5" Content="One statement per line"
                                      Checked="formatSetting_Checked" Unchecked="formatSetting_Unchecked"/>
                        </UniformGrid>

                        <TextBlock Text="Short statement threshold (characters):" Margin="0,10,0,2"/>
                        <TextBox x:Name="FormatSingleLineThreshold" Width="70" HorizontalAlignment="Left"
                                 TextChanged="formatSetting_TextChanged"/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Advanced options..." Width="140" Height="26"
                                    Click="Button_OpenAdvancedFormatOptions_Click"/>
                            <Button Content="Import profile..." Width="120" Height="26" Margin="8,0,0,0"
                                    Click="Button_ImportFormatProfile_Click"/>
                            <Button Content="Export profile..." Width="120" Height="26" Margin="8,0,0,0"
                                    Click="Button_ExportFormatProfile_Click"/>
                            <Button Content="Restore defaults" Width="120" Height="26" Margin="8,0,0,0"
                                    Click="Button_RestoreFormatDefaults_Click"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Save" Click="Button_SaveApplyAdditionalFormat_Click"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Width="90" Height="26"/>
                            <TextBlock x:Name="FormatSaveStatus" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Opacity="0.8" Text="No unsaved changes"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="Source query" Grid.Column="0" Margin="0,0,4,0">
                            <TextBox x:Name="SourceQueryPreview"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas"
                                 FontSize="12"/>
                        </GroupBox>

                        <GroupBox Header="Formatted query" Grid.Column="1" Margin="4,0,0,0">
                            <TextBox x:Name="FormattedQueryPreview"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"/>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>





            <TabItem Header="Connection Colors">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Color query window status bars and document tabs based on the server and/or database name. If both fields are filled, both must match. Leave a field empty to match anything."/>
                        <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ToolThemeForegroundBrush}" Opacity="0.8" FontStyle="Italic"
                                   Text="Examples: Server='PROD' matches SQL-PROD-01. Database='master' matches any connection to master. Server='PROD' + Database='Sales' matches only Sales on PROD servers. First matching rule wins."/>
                    </StackPanel>

                    <!-- Add new rule area -->
                    <GroupBox Grid.Row="1" x:Name="ConnectionColorRuleEditor" Header="Add new rule" Margin="0,0,0,10" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Server name contains:"
                                       VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="NewRuleServerPattern"
                                     VerticalContentAlignment="Center" Padding="4,2" Margin="0,0,0,4"
                                     ToolTip="e.g. PROD, DEV, localhost, 192.168.1 (leave empty to match any server)"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Database name contains:"
                                       VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="NewRuleDatabasePattern"
                                     VerticalContentAlignment="Center" Padding="4,2" Margin="0,0,0,4"
                                     ToolTip="e.g. master, MyDB, _prod (leave empty to match any database)"/>

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Status bar and tab color:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border x:Name="NewRuleColorPreview" Width="30" Height="22"
                                    Background="#FF4444" BorderBrush="{DynamicResource ToolThemeBorderBrush}" BorderThickness="1"
                                        CornerRadius="2" Margin="0,0,5,0"
                                        Cursor="Hand" MouseLeftButtonUp="NewRuleColorPreview_Click"
                                        ToolTip="Click to pick a color"/>
                                <Button Content="Pick color..." Click="NewRuleColorPreview_Click" Margin="0,0,15,0"/>
                                <Button x:Name="button_CommitColorRule" Content="+ Add" Click="ButtonAddColorRule_Click"
                                        Style="{DynamicResource PrimaryButtonStyle}" FontWeight="Bold" MinWidth="80"/>
                                <Button x:Name="button_CancelColorRuleEdit" Content="Cancel edit"
                                        Click="ButtonCancelColorRuleEdit_Click" Margin="5,0,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Rules list -->
                    <GroupBox Grid.Row="2" Header="Configured rules" Padding="5">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
                                <Button x:Name="button_EditColorRule" Content="Edit selected" Click="ButtonEditColorRule_Click"
                                        Width="100" Margin="0,0,5,0" FontWeight="Bold"/>
                                <Button x:Name="button_RemoveColorRule" Content="Remove selected" Click="ButtonRemoveColorRule_Click"
                                        Width="120" Margin="0,0,5,0"/>
                                <Button x:Name="button_MoveColorRuleUp" Content="Move up" Click="ButtonMoveColorRuleUp_Click"
                                        Width="80" Margin="0,0,5,0"/>
                                <Button x:Name="button_MoveColorRuleDown" Content="Move down" Click="ButtonMoveColorRuleDown_Click"
                                        Width="90"/>
                            </StackPanel>
                            <ListView x:Name="ConnectionColorRulesListView"
                                      Background="{DynamicResource ToolThemeBackgroundBrush}"
                                      BorderBrush="{DynamicResource ToolThemeBorderBrush}"
                                      Foreground="{DynamicResource ToolThemeForegroundBrush}"
                                      ItemContainerStyle="{StaticResource SettingsListViewItemStyle}"
                                      SelectionMode="Single"
                                      SelectionChanged="ConnectionColorRulesListView_SelectionChanged"
                                      MouseDoubleClick="ConnectionColorRulesListView_MouseDoubleClick">
                                <ListView.View>
                                    <GridView ColumnHeaderContainerStyle="{StaticResource SettingsGridViewHeaderStyle}">
                                        <GridViewColumn Header="Enabled" Width="65">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsEnabled}" Click="ConnectionColorRuleEnabled_Click" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Server contains" Width="180"
                                                        DisplayMemberBinding="{Binding ServerNamePattern}"/>
                                        <GridViewColumn Header="Database contains" Width="180"
                                                        DisplayMemberBinding="{Binding DatabaseNamePattern}"/>
                                        <GridViewColumn Header="Color" Width="70">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Width="50" Height="18" CornerRadius="2"
                                                            Background="{Binding StatusBarColor}"
                                                            BorderBrush="{DynamicResource ToolThemeBorderBrush}" BorderThickness="1"
                                                            Cursor="Hand"
                                                            MouseLeftButtonUp="RuleColorPreview_Click"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </GroupBox>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="button_SaveConnectionColorRules"
                                Click="Button_SaveConnectionColorRules_Click"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Width="90" Height="24" FontWeight="Bold">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<Viewbox Width="16" Height="16" Margin="0,0,4,0">
								<Path Fill="{DynamicResource ToolThemePrimaryButtonForegroundBrush}" Stretch="Fill" SnapsToDevicePixels="True" Data="{StaticResource SaveIconGeometry}"/>
							</Viewbox>
                                <TextBlock Text="Save" VerticalAlignment="Center" Foreground="{DynamicResource ToolThemePrimaryButtonForegroundBrush}"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="ConnectionColorSaveStatus" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Opacity="0.8" Text="No unsaved changes"/>
                    </StackPanel>
                </Grid>
            </TabItem>


            <TabItem Header="Updates">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0"
                              x:Name="EnableUpdateChecks"
                              Content="Check for MSSQL Tool updates on startup"
                              Margin="5"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
                        <Button x:Name="button_SaveUpdateSettings"
                                Click="button_SaveUpdateSettings_Click"
                                Width="80"
                                Height="24"
                                Margin="0,0,10,0"
                                FontWeight="Bold">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="16" Height="16" Margin="0,0,4,0">
                                    <Path Style="{StaticResource SaveIconPathStyle}" Data="{StaticResource SaveIconGeometry}"/>
                                </Viewbox>
                                <TextBlock Text="Save" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="button_CheckUpdates"
                                Click="button_CheckUpdates_Click"
                                Width="130"
                                Height="24"
                                FontWeight="Bold">
                            <TextBlock Text="Check for updates" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <GroupBox Grid.Row="2" Header="Update status" Margin="5">
                        <TextBlock x:Name="UpdateCheckStatus"
                                   TextWrapping="Wrap"
                                   Margin="5"/>
                    </GroupBox>
                </Grid>
            </TabItem>


            <TabItem Header="OpenAI - ChatGPT integration"
					Visibility="Collapsed">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0"
						   Content="API key:"
						   Margin="5"/>
                    <PasswordBox Grid.Row="0" Grid.Column="1"
								 x:Name="OpenAiApiKey"
								 Margin="5"/>

                    <Button Grid.Row="1" Grid.Column="1"
							Content="Save"
							x:Name="button_SaveOpenAi"
							Click="Button_SaveOpenAi_Click"
							Width="60"
							Margin="5"
							HorizontalAlignment="Left"
							FontWeight="Bold"/>
                </Grid>
            </TabItem>

            <TabItem Header="Diagnostics">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Refresh" Width="90" Click="Button_RefreshDiagnostics_Click"/>
                        <Button Content="Copy report" Width="110" Margin="8,0,0,0" Click="Button_CopyDiagnostics_Click"/>
                    </StackPanel>
                    <TextBox x:Name="DiagnosticsText" FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</UserControl>
