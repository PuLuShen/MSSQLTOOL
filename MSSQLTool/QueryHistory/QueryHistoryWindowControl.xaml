<UserControl x:Class="MSSQLTool.QueryHistoryWindowControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit" Background="{DynamicResource ToolThemeBackgroundBrush}" Foreground="{DynamicResource ToolThemeForegroundBrush}">
 <UserControl.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/MSSQLTool;component/Themes/SharedToolWindowTheme.xaml"/></ResourceDictionary.MergedDictionaries>
   <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid Margin="6">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition Height="2*"/></Grid.RowDefinitions>

  <DockPanel Grid.Row="0" Margin="0,0,0,6">
   <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
    <TextBlock Text="{Binding LastRefreshed}" VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.75"/>
    <Button Content="Options" Width="80" Click="ToggleOptions_Click" Margin="0,0,5,0"/>
    <Button Content="Refresh" Width="80" Command="{Binding RefreshCommand}" Style="{DynamicResource PrimaryButtonStyle}"/>
   </StackPanel>
   <TextBlock Text="Query History" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
  </DockPanel>

  <!-- Storage and retention options. They used to live on a page of the settings window;
       keeping them next to the history they configure makes the effect immediately visible. -->
  <Expander x:Name="OptionsPanel" Grid.Row="1" Header="History storage options"
            Visibility="Collapsed" Margin="0,0,0,6" Padding="8"
            BorderBrush="{DynamicResource ToolThemeBorderBrush}" BorderThickness="1">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Text="Storage:" VerticalAlignment="Center" Margin="0,0,8,6"/>
    <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="HistoryStorageMode" Width="260"
              HorizontalAlignment="Left" Margin="0,0,0,6" SelectionChanged="HistoryStorageMode_SelectionChanged">
     <ComboBoxItem Content="Local SQLite database (recommended)" Tag="Sqlite"/>
     <ComboBoxItem Content="Local text files (JSONL)" Tag="TextFiles"/>
     <ComboBoxItem Content="Do not record history" Tag="Disabled"/>
    </ComboBox>

    <TextBlock Grid.Row="1" Grid.Column="0" Text="Database:" VerticalAlignment="Center" Margin="0,0,8,6"/>
    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="HistoryDatabasePath" Margin="0,0,8,6"
               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,6">
     <Button Content="Open folder" Click="OpenHistoryFolder_Click" Margin="0,0,5,0"/>
     <Button Content="Import text files" Click="ImportTextFiles_Click"
             ToolTip="Import history previously recorded in the JSONL text files"/>
    </StackPanel>

    <TextBlock Grid.Row="2" Grid.Column="0" Text="Retention (days):" VerticalAlignment="Center" Margin="0,0,8,6"/>
    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,6">
     <TextBox x:Name="HistoryRetentionDays" Width="60"/>
     <TextBlock Text="0 keeps history forever" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.75"/>
    </StackPanel>

    <CheckBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="HistoryRedactSensitiveText"
              Content="Redact passwords, tokens and keys before storing" Margin="0,0,0,6"/>

    <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
     <Button Content="Save options" Click="SaveHistoryOptions_Click" Width="110" Height="26"
             Style="{DynamicResource PrimaryButtonStyle}"/>
     <TextBlock x:Name="HistoryOptionsStatus" Margin="10,0,0,0" VerticalAlignment="Center"
                Opacity="0.8" Text="No unsaved changes"/>
    </StackPanel>
   </Grid>
  </Expander>

  <Border Grid.Row="2" Padding="8" Margin="0,0,0,6" BorderThickness="1" CornerRadius="2" BorderBrush="{DynamicResource ToolThemeBorderBrush}" Background="{DynamicResource ToolThemeHeaderBackgroundBrush}">
   <DockPanel>
    <ProgressBar DockPanel.Dock="Right" Width="90" Height="4" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Style.Triggers><DataTrigger Binding="{Binding StatusKind}" Value="Error"><Setter Property="Foreground" Value="#E5534B"/></DataTrigger><DataTrigger Binding="{Binding StatusKind}" Value="Warning"><Setter Property="Foreground" Value="#D99A22"/></DataTrigger><DataTrigger Binding="{Binding StatusKind}" Value="Success"><Setter Property="Foreground" Value="#3AA675"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </DockPanel>
  </Border>

  <Border Grid.Row="3" Padding="6" Margin="0,0,0,6" BorderThickness="1" BorderBrush="{DynamicResource ToolThemeBorderBrush}">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
     <TextBlock Text="Date:" VerticalAlignment="Center" Margin="0,0,5,0"/><Button Content="Today" Tag="1" Click="DatePreset_Click" Margin="0,0,4,0"/><Button Content="7 days" Tag="7" Click="DatePreset_Click" Margin="0,0,4,0"/><Button Content="30 days" Tag="30" Click="DatePreset_Click" Margin="0,0,10,0"/><Button Content="Current connection" Click="CurrentConnection_Click" Margin="0,0,10,0"/>
     <DatePicker Width="125" SelectedDate="{Binding FilterFromDate, Mode=TwoWay}"/><TextBlock Text="–" Margin="5,0" VerticalAlignment="Center"/><DatePicker Width="125" SelectedDate="{Binding FilterToDate, Mode=TwoWay}"/>
     <TextBlock Text="Result:" Margin="14,0,5,0" VerticalAlignment="Center"/><ComboBox Width="110" ItemsSource="{Binding ResultOptions}" SelectedItem="{Binding FilterResult}"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0" Margin="0,0,5,0"><TextBlock Text="Server"/><TextBox Text="{Binding FilterServer, UpdateSourceTrigger=PropertyChanged}" ToolTip="Server contains..." KeyDown="Filter_KeyDown"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="0,0,5,0"><TextBlock Text="Database"/><TextBox Text="{Binding FilterDatabase, UpdateSourceTrigger=PropertyChanged}" ToolTip="Database contains..." KeyDown="Filter_KeyDown"/></StackPanel>
     <StackPanel Grid.Column="2" Margin="0,0,5,0"><TextBlock Text="Login"/><TextBox Text="{Binding FilterLogin, UpdateSourceTrigger=PropertyChanged}" ToolTip="Login contains..." KeyDown="Filter_KeyDown"/></StackPanel>
     <StackPanel Grid.Column="3"><TextBlock Text="SQL keywords"/><TextBox Text="{Binding FilterQueryText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Separate keywords with spaces; all terms must match" KeyDown="Filter_KeyDown"/></StackPanel>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Apply filters" Width="95" Command="{Binding RefreshCommand}" Style="{DynamicResource PrimaryButtonStyle}"/><Button Content="Clear filters" Width="95" Margin="5,0,0,0" Command="{Binding ClearFilterCommand}"/></StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0" Margin="2,0,2,4"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Previous" Command="{Binding PreviousPageCommand}"/><TextBlock Text="{Binding PageSummary}" Margin="9,0" VerticalAlignment="Center"/><Button Content="Next" Command="{Binding NextPageCommand}"/></StackPanel><TextBlock Text="{Binding ResultSummary}" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
   <DataGrid x:Name="HistoryGrid" Grid.Row="1" IsReadOnly="True" ItemsSource="{Binding QueryHistoryRecords}" SelectedItem="{Binding SelectedRecord, Mode=TwoWay}" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="HistoryGrid_SelectionChanged" MouseDoubleClick="HistoryGrid_MouseDoubleClick" Style="{DynamicResource ToolThemedDataGridStyle}" ColumnHeaderStyle="{DynamicResource ToolThemedDataGridColumnHeaderStyle}" CellStyle="{DynamicResource ToolThemedDataGridCellStyle}" RowStyle="{DynamicResource ToolThemedDataGridRowStyle}">
    <DataGrid.ContextMenu><ContextMenu><MenuItem Header="Open in new query window" Click="OpenQuery_Click"/><MenuItem Header="Copy SQL" Click="CopyQuery_Click"/></ContextMenu></DataGrid.ContextMenu>
    <DataGrid.Columns>
     <DataGridTextColumn Header="Started" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="145"/>
     <DataGridTextColumn Header="Query" Binding="{Binding QueryTextShort}" Width="*" MinWidth="250"/>
     <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="130"/>
     <DataGridTextColumn Header="Elapsed" Binding="{Binding ElapsedTime}" Width="80"/>
     <DataGridTextColumn Header="Result" Binding="{Binding ExecResult}" Width="90"/>
     <DataGridTextColumn Header="Server" Binding="{Binding DataSource}" Width="130"/>
     <DataGridTextColumn Header="Rows" Binding="{Binding TotalRowsReturned, StringFormat=N0}" Width="70"/>
     <DataGridTextColumn Header="Login" Binding="{Binding LoginName}" Width="100" Visibility="Collapsed"/>
     <DataGridTextColumn Header="Workstation" Binding="{Binding WorkstationId}" Width="100" Visibility="Collapsed"/>
    </DataGrid.Columns>
   </DataGrid>
  </Grid>
  <GridSplitter Grid.Row="5" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
  <Grid Grid.Row="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0" Margin="0,2,0,4"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><CheckBox x:Name="WrapSql" Content="Wrap lines" Margin="0,0,10,0" VerticalAlignment="Center" Checked="WrapSql_Changed" Unchecked="WrapSql_Changed"/><Button Content="Copy SQL" Click="CopyQuery_Click"/><Button Content="Open in new query window" Margin="5,0,0,0" Click="OpenQuery_Click" Style="{DynamicResource PrimaryButtonStyle}"/></StackPanel><TextBlock Text="SQL details" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
   <avalonedit:TextEditor x:Name="SqlEditor" Grid.Row="1" FontFamily="Consolas" FontSize="12" IsReadOnly="True" ShowLineNumbers="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
  </Grid>
 </Grid>
</UserControl>
