<UserControl x:Class="MSSQLTool.DataImportWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="600"
             d:DesignHeight="640">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Data Import" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Foreground="Gray"
                       Text="Use this window to import Excel spreadsheets into the database currently selected in Object Explorer." />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,0" Padding="12" BorderBrush="#FFD9D9D9" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Excel file" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <TextBox x:Name="TextBox_ExcelPath" Width="320" MinWidth="220" IsReadOnly="True" />
                    <Button x:Name="Button_Browse" Content="Browse..." Margin="8,0,0,0" Padding="12,4" Click="ButtonBrowse_OnClick" />
                </StackPanel>

                <TextBlock Text="Worksheet name" Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,0" />
                <ComboBox x:Name="ComboBox_Worksheet"
                          Grid.Row="1"
                          Grid.Column="1"
                          Margin="8,10,0,0"
                          IsEditable="True"
                          SelectionChanged="ComboBox_Worksheet_SelectionChanged"
                          ToolTip="Pick a worksheet from the workbook, or type a sheet name to override." />

                <TextBlock Text="Target database" Grid.Row="2" VerticalAlignment="Center" Margin="0,10,0,0" />
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,10,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="TextBox_Target" Width="320" IsReadOnly="True" />
                    <Button x:Name="Button_SelectTarget" Content="Select" Margin="8,0,0,0" Padding="16,4" Click="ButtonSelectTarget_OnClick" />
                </StackPanel>

                <TextBlock Text="Destination table" Grid.Row="3" VerticalAlignment="Center" Margin="0,10,0,0" />
                <TextBox x:Name="TextBox_TargetTable"
                         Grid.Row="3"
                         Grid.Column="1"
                         Margin="8,10,0,0"
                         TextChanged="TextBox_TargetTable_OnTextChanged" />

                <TextBlock Text="Timeout (seconds, 0 = no limit)" Grid.Row="4" VerticalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" />
                <TextBox x:Name="TextBox_Timeout"
                         Grid.Row="4"
                         Grid.Column="1"
                         Width="80"
                         HorizontalAlignment="Left"
                         Margin="8,10,0,0"
                         Text="0"
                         VerticalContentAlignment="Center"
                         ToolTip="Maximum seconds allowed for the bulk copy; 0 = no limit." />

                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Vertical" Margin="8,12,0,0">
                    <CheckBox x:Name="CheckBox_CreateTable" Content="Automatically create the table if it does not exist" IsChecked="True" Checked="CheckBox_CreateTable_Changed" Unchecked="CheckBox_CreateTable_Changed" />
                    <CheckBox x:Name="CheckBox_Truncate" Content="Truncate the table before importing" />
                    <CheckBox x:Name="CheckBox_FirstRowHeaders" Content="Treat first row as column headers" IsChecked="True" Checked="CheckBox_FirstRowHeaders_Changed" Unchecked="CheckBox_FirstRowHeaders_Changed" />
                    <CheckBox x:Name="CheckBox_CheckConstraints" Content="Validate SQL Server constraints during import" IsChecked="True" />
                </StackPanel>
            </Grid>
        </Border>

        <GroupBox Grid.Row="2"
                  x:Name="Group_ColumnMapping"
                  Header="Column mapping"
                  Margin="0,16,0,0"
                  Padding="8">
            <StackPanel>
                <TextBlock x:Name="TextBlock_MappingInfo"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"
                           Text="Choose an Excel file and worksheet, then select an existing destination table to map its columns." />
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ItemsControl_ColumnMapping">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="240" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ExcelColumn}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ExcelColumn}" />
                                    <TextBlock Grid.Column="1" Text="→" Margin="8,0" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding TargetColumns}"
                                              SelectedItem="{Binding SelectedTarget, Mode=TwoWay}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </GroupBox>

        <Border Grid.Row="3" Margin="0,16,0,0" Padding="12" BorderBrush="#FFE8E8E8" BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="Process checklist" FontWeight="SemiBold" />
                <ItemsControl Margin="0,8,0,0">
                    <ItemsControl.Items>
                        <TextBlock Text="1. Choose the Excel workbook that contains the data." />
                        <TextBlock Text="2. Point to the Object Explorer database that will receive the data." />
                        <TextBlock Text="3. Provide the destination table name and confirm optional behaviors." />
                        <TextBlock Text="4. Click Import to perform the one-click upload." />
                    </ItemsControl.Items>
                </ItemsControl>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock x:Name="TextBlock_Status" VerticalAlignment="Center" Foreground="Gray" Text="Choose an Excel file to get started." />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="Button_Clear" Content="Reset" Margin="0,0,8,0" Padding="16,4" Click="ButtonClear_OnClick" />
                <Button x:Name="Button_Cancel" Content="Cancel" Margin="0,0,8,0" Padding="16,4" Visibility="Collapsed" Click="ButtonCancel_OnClick" />
                <Button x:Name="Button_Import" Content="Import" Padding="24,6" IsEnabled="False" Click="ButtonImport_OnClick" />
            </StackPanel>
        </DockPanel>

        <GroupBox Grid.Row="5" Header="Data preview" Margin="0,16,0,0" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="TextBlock_PreviewStatus"
                           Foreground="Gray"
                           Margin="0,0,0,6"
                           Text="Choose an Excel file and worksheet to see a preview." />
                <DataGrid x:Name="PreviewGrid"
                          Grid.Row="1"
                          Height="150"
                          IsReadOnly="True"
                          AutoGenerateColumns="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True" />
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
