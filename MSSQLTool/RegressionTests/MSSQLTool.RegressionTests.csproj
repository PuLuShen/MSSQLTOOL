<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{B8EC6119-7561-4C88-9903-76C31F84270A}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>MSSQLTool.RegressionTests</RootNamespace>
    <AssemblyName>MSSQLTool.RegressionTests</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <!-- SSMS is 64-bit and its SQLite engine is x64; the history probe mirrors that. -->
    <Prefer32Bit>false</Prefer32Bit>
    <SsmsInstallRoot Condition="'$(SsmsInstallRoot)' == ''">C:\Program Files\Microsoft SQL Server Management Studio 22\Release</SsmsInstallRoot>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <OutputPath>bin\Debug\</OutputPath><DebugSymbols>true</DebugSymbols><DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <OutputPath>bin\Release\</OutputPath><Optimize>true</Optimize><DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="Microsoft.SqlServer.TransactSql.ScriptDom">
      <HintPath>$(SsmsInstallRoot)\Common7\IDE\Extensions\Application\Microsoft.SqlServer.TransactSql.ScriptDom.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(SsmsInstallRoot)\Common7\IDE\PrivateAssemblies\Newtonsoft.Json.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Microsoft.Data.SqlClient">
      <HintPath>$(SsmsInstallRoot)\Common7\IDE\Microsoft.Data.SqlClient.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="FormatterProbe.cs" />
    <Compile Include="FormattingTests.cs" />
    <Compile Include="CompletionSelectionTests.cs" />
    <Compile Include="CompletionCorpusTests.cs" />
    <Compile Include="CompletionParameterInfoTests.cs" />
    <Compile Include="UpdateHelperTests.cs" />
    <Compile Include="StorageTests.cs" />
    <Compile Include="AnalysisTests.cs" />
    <Compile Include="RefactorTests.cs" />
    <Compile Include="AnalyticsTests.cs" />
    <Compile Include="EditorBackgroundTests.cs" />
    <Compile Include="ResultSetTests.cs" />
    <Compile Include="StorageProbe.cs" />
    <Compile Include="HistoryProbe.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MSSQLTool.csproj">
      <Project>{0053E521-4D51-4E8C-B3E6-3DAC1912037B}</Project><Name>MSSQLTool</Name>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- The history probe opens a real SQLite database, so it needs the engine SSMS ships. -->
  <ItemGroup Condition="Exists('$(SsmsInstallRoot)\Common7\IDE\CommonExtensions\Microsoft\VBCSharp\LanguageServices\e_sqlite3.dll')">
    <HistoryProbeNative Include="$(SsmsInstallRoot)\Common7\IDE\CommonExtensions\Microsoft\VBCSharp\LanguageServices\e_sqlite3.dll" />
  </ItemGroup>
  <Target Name="CopyHistoryProbeNative" AfterTargets="Build" Condition="'@(HistoryProbeNative)' != ''">
    <Copy SourceFiles="@(HistoryProbeNative)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>
</Project>

