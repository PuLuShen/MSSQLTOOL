<Window x:Class="MSSQLTool.CreateQueryTemplateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Query Template" Width="720" Height="560"
        MinWidth="560" MinHeight="420" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="{DynamicResource ToolThemeBackgroundBrush}"
        Foreground="{DynamicResource ToolThemeForegroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MSSQLTool;component/Themes/SharedToolWindowTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="95" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Template name:" VerticalAlignment="Center" Margin="0,0,8,8" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,0,0,8"
                 VerticalContentAlignment="Center" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Category:" VerticalAlignment="Center" Margin="0,0,8,8" />
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CategoryBox" Margin="0,0,0,8"
                  IsEditable="True" IsTextSearchEnabled="True" />

        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="Use a subfolder such as 运维\阻塞; leave empty to save in the root folder."
                   TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" />

        <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ContentBox"
                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                 FontFamily="Consolas" FontSize="13"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />

        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ValidationText"
                   Foreground="{DynamicResource ToolThemeStatusErrorBrush}" Margin="0,8,0,0"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save template" Width="105" Height="28" FontWeight="Bold"
                    IsDefault="True" Style="{DynamicResource PrimaryButtonStyle}" Click="SaveButton_Click" />
            <Button Content="Cancel" Width="80" Height="28" Margin="8,0,0,0"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
