<UserControl x:Class="MSSQLTool.QueryTemplateWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             mc:Ignorable="d"
             MinWidth="720" MinHeight="420"
             Background="{DynamicResource ToolThemeBackgroundBrush}"
             Foreground="{DynamicResource ToolThemeForegroundBrush}"
             Loaded="Control_Loaded"
             Unloaded="Control_Unloaded"
             PreviewKeyDown="Control_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MSSQLTool;component/Themes/SharedToolWindowTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="1" x:Name="SearchBox" Height="27" VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged" ToolTip="Search template names and folders" />
            <ComboBox Grid.Column="2" x:Name="ScopeBox" Width="115" Height="27" Margin="8,0,0,0"
                      SelectionChanged="ScopeBox_SelectionChanged">
                <ComboBoxItem Content="All templates" Tag="All" IsSelected="True" />
                <ComboBoxItem Content="Favorites" Tag="Favorites" />
                <ComboBoxItem Content="Recent" Tag="Recent" />
            </ComboBox>
            <Button Grid.Column="3" Content="Refresh" Width="74" Height="27" Margin="8,0,0,0"
                    Click="RefreshButton_Click" />
        </Grid>

        <DockPanel Grid.Row="1" Margin="0,0,0,7" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="Templates folder:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Content="Choose folder..." Padding="9,2" Margin="0,0,5,0" Click="ChooseFolderButton_Click" />
                <Button Content="Open folder" Padding="9,2" Click="OpenFolderButton_Click" />
            </StackPanel>
            <TextBlock x:Name="RootFolderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </DockPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,7">
            <Button Content="Create template..." Padding="10,3" FontWeight="Bold"
                    Click="CreateTemplateButton_Click" />
            <Button Content="Migrate folder..." Padding="10,3" Margin="7,0,0,0"
                    Click="MigrateFolderButton_Click" />
            <TextBlock Text="Creation uses the selected SQL, or the entire active query when nothing is selected."
                       Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.75" />
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="300" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="3*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" x:Name="TemplateGrid"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                      SelectionChanged="TemplateGrid_SelectionChanged"
                      MouseDoubleClick="TemplateGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="" Binding="{Binding FavoriteGlyph}" Width="32" />
                    <DataGridTextColumn Header="Template" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Folder" Binding="{Binding CategoryDisplay}" Width="150" />
                    <DataGridTextColumn Header="Modified" Binding="{Binding LastWriteDisplay}" Width="125" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="{DynamicResource ToolThemeBorderBrush}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="SelectedPathText" Grid.Row="0" FontWeight="Bold" Margin="7,0,0,6"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <avalonedit:TextEditor Grid.Row="1" x:Name="PreviewEditor" Margin="7,0,0,0"
                                       ShowLineNumbers="True" FontFamily="Consolas" FontSize="13"
                                       Background="{DynamicResource ToolThemeBackgroundBrush}"
                                       Foreground="{DynamicResource ToolThemeForegroundBrush}"
                                       IsReadOnly="True" HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,6">
            <Button x:Name="InsertButton" Content="Insert" Width="90" Height="28" FontWeight="Bold"
                    Style="{DynamicResource PrimaryButtonStyle}" Click="InsertButton_Click" />
            <Button x:Name="NewQueryButton" Content="Open in new query" Width="125" Height="28" Margin="7,0,0,0"
                    Click="NewQueryButton_Click" />
            <Button x:Name="FavoriteButton" Content="Add favorite" Width="105" Height="28" Margin="7,0,0,0"
                    Click="FavoriteButton_Click" />
            <Button x:Name="ShowFileButton" Content="Show file" Width="85" Height="28" Margin="7,0,0,0"
                    Click="ShowFileButton_Click" />
            <TextBlock Text="Enter: insert   Ctrl+Enter: new query" Margin="14,0,0,0" VerticalAlignment="Center" Opacity="0.75" />
        </StackPanel>

        <!-- Settings Section: hosts the former "Query Templates" settings page -->
        <Expander x:Name="SettingsPanel" Grid.Row="5" Header="Settings" IsExpanded="False"
                  Margin="0,4,0,0" Padding="0,4,0,4">
            <Grid Margin="6,4,6,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Templates Folder:"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,2,0,2">
                    <Button DockPanel.Dock="Right" Content="Select folder..." Padding="9,2" Margin="6,0,0,0"
                            Click="SelectTemplatesFolderButton_Click" />
                    <TextBox x:Name="TemplatesFolderBox" VerticalContentAlignment="Center" Height="24"
                             ToolTip="Folder that stores the template .sql files" />
                </DockPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Save" Width="80" Height="26" FontWeight="Bold"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Click="SaveTemplatesFolderButton_Click" />
                    <Button Content="Refresh templates" Width="130" Height="26" Margin="7,0,0,0"
                            Click="RefreshTemplatesSettingsButton_Click" />
                </StackPanel>

                <TextBlock x:Name="SettingsStatusText" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                           Margin="0,6,0,0" Opacity="0.8" TextWrapping="Wrap" />

                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                            Margin="0,8,0,0">
                    <TextBlock Text="Useful TSQL scripts" VerticalAlignment="Center" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center">
                        <Hyperlink NavigateUri="https://github.com/PuLuShen/MSSQLTOOL"
                                   RequestNavigate="GitHubRepositoryLink_Click">
                            <Run Text="https://github.com/PuLuShen/MSSQLTOOL" />
                        </Hyperlink>
                    </TextBlock>
                    <Button Content="Download TSQL scripts from GitHub" Margin="14,0,0,0" Padding="9,2"
                            Click="DownloadScriptsButton_Click" />
                </StackPanel>
            </Grid>
        </Expander>

        <StatusBar Grid.Row="6" Background="{DynamicResource ToolThemeBackgroundBrush}"
                   Foreground="{DynamicResource ToolThemeForegroundBrush}">
            <StatusBarItem><TextBlock x:Name="StatusText" /></StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
